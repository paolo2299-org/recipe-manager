ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Development reserves a free port automatically and binds to Tailscale when
# available. Use DEV_HOST=127.0.0.1 make dev-start for local-only access.
# Optional: send traces to Honeycomb. Set to your Honeycomb ingest API key.
HONEYCOMB_API_KEY=
# Optional: override the OTel service name (default: recipe-manager).
# OTEL_SERVICE_NAME=recipe-manager
SECRET_KEY=change-me-in-production
FLASK_ENV=development
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-in-production
# Optional: enables the /mcp endpoint; MCP clients connect with OAuth and you
# approve each one while signed in. Requires AUTH_ENABLED in production.
# MCP_ENABLED=true
# Optional: override the production SQLite DB location. Development always uses
# this worktree's .dev/recipes.db regardless of DATABASE_PATH.
# Defaults to /app/data/recipes.db inside the container (set in the Dockerfile).
# DATABASE_PATH=/app/data/recipes.db
